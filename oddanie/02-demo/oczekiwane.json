[
 {
  "id": 1,
  "opis": "Godziny dzwonienia pn-pt 9-19, sobota 9-15, niedziela nie; godziny salonu sobota do 15 (oba salony); brak soboty do 14",
  "atomy": [
   {
    "opis": "pn-pt 9-19",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "(?:9|dziewiat\\w*)(?:[:.]00)?\\s*(?:-|do|a)\\s*(?:19|dziewietnast\\w*)"
     ]
    }
   },
   {
    "opis": "sobota do 15 (dzwonienie)",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "sobot\\w*(?:(?!\\.\\s|;)[\\s\\S]){0,40}?(?<![\\d:.])(?:15|pietnast\\w*)(?![\\d])"
     ]
    }
   },
   {
    "opis": "niedziela bez dzwonienia",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "niedziel\\w*"
     ]
    }
   },
   {
    "opis": "godziny salonu podawane przez agenta: sobota do 15",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "godzin\\w*\\s+(?:otwarcia\\s+)?salon\\w*|salon\\w*(?:(?!\\.\\s|;)[\\s\\S]){0,30}godzin|podaj\\w*(?:(?!\\.\\s|;)[\\s\\S]){0,50}godzin|godzin\\w*(?:(?!\\.\\s|;)[\\s\\S]){0,60}(?:klient|podaj)",
      "sobot\\w*(?:(?!\\.\\s|;)[\\s\\S]){0,40}?(?<![\\d:.])(?:15|pietnast\\w*)(?![\\d])"
     ]
    }
   },
   {
    "opis": "brak soboty do 14 w polach strukturalnych",
    "rodzaj": "brak",
    "gdzie": {
     "tekst": [
      "sobot\\w*(?:\\W+\\w+){0,4}?\\W*(?:-|do)\\s*(?:godz\\w*\\s*)?(?:14|czternast\\w*)(?:[:.]00)?(?![\\d]|[:.]\\d)"
     ]
    }
   }
  ]
 },
 {
  "id": 2,
  "opis": "Adres Włocławek Toruńska 120; po poprawce napisać do Kasi",
  "atomy": [
   {
    "opis": "Toruńska 120",
    "rodzaj": "istnieje",
