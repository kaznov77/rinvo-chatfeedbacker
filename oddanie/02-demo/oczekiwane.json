      "torunsk\\w*\\s*(?:nr\\.?\\s*)?120"
     ]
    }
   },
   {
    "opis": "napisać do Kasi po poprawce",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "adres|kapitulnej|torunsk|baza wiedzy",
      "\\b(?:na|od)?pis(?:z|a|ac|ze|zemy|ania)\\w*|\\b(?:poinform|powiadom|da[cć] zna|odpis|wiadomo|informac|zawiadom)\\w*",
      "kasi\\w*"
     ]
    }
   }
  ]
 },
 {
  "id": 3,
  "opis": "Błąd: ponowne dzwonienie po rozłączeniu w 3 s; 6 przypadków, 16:40, numer na 14, limit 5 prób bez zmian",
  "atomy": [
   {
    "opis": "błąd + rozłączenie w 3 s + ponowne dzwonienie",
    "rodzaj": "istnieje",
    "gdzie": {
     "typ": [
      "błąd"
     ],
     "tekst": [
      "(?<!\\d)(?:3|trzech|trzy)\\s*(?:s\\b|sek\\w*)",
      "ponown\\w*|drugi\\w*|podwojn\\w*|dwukrotn\\w*|dwa razy|ponowie"
     ]
    }
   },
   {
    "opis": "6 przypadków",
    "rodzaj": "istnieje",
    "gdzie": {
     "typ": [
      "błąd"
     ],
     "tekst": [
      "(?<![\\d.:])(?:6|szesc\\w*)(?![\\d])"
     ]
    }
   },
   {
    "opis": "16:40",
    "rodzaj": "istnieje",
    "gdzie": {
     "typ": [
      "błąd"
     ],
     "tekst": [
      "16\\s*[:.]\\s*40"
     ]
    }
   },
   {
    "opis": "numer kończy się na 14",
    "rodzaj": "istnieje",
    "gdzie": {
     "typ": [
      "błąd"
     ],
     "tekst": [
      "(?<!\\d)14(?!\\d)|czternast"
     ]
    }
   },
   {
    "opis": "limit 5 prób",
    "rodzaj": "istnieje",
    "gdzie": {
     "tekst": [
      "limit\\w*\\W+(?:\\w+\\W+){0,6}?(?:5|piec\\w*)(?![\\d])|(?:5|piec\\w*)\\W+(?:\\w+\\W+){0,1}?pr[oó]b"
     ]
    }
   }
  ]
 },
